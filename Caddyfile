# Caddyfile — production: wildcard TLS qua DNS challenge, reverse về guard.
# DNS: A *.tunnel.example.com -> VPS_IP. Guard nghe 127.0.0.1:19090, frps vhost 127.0.0.1:8080.
# Không dùng on-demand (mở abuse cấp cert). Cần plugin DNS tương ứng + token qua env.
# Ví dụ Cloudflare: docker build caddy:2-builder cloudflare; env CF_API_TOKEN.
{
	auto_https off
}

# HTTP: redirect về HTTPS, giữ path/query.
:80 {
	@app_tunnel host *.tunnel.example.com tunnel.example.com
	handle @app_tunnel {
		uri replace ^/(.*)$ https://{http.request.host}/{http.request.uri}
		redir {http.request.uri} permanent
	}
	handle {
		respond "sr8 edge ok" 200
	}
}

# Production: wildcard + DNS challenge (đổi dns provider + env token của bạn).
*.tunnel.example.com, tunnel.example.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	# Guard là cửa duy nhất ra ngoài. frps KHÔNG public trực tiếp.
	reverse_proxy 127.0.0.1:19090 {
		# Giữ X-Forwarded-For để guard rate-limit đúng IP thật.
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto {http.request.scheme}
	}
	log {
		output stdout
		format json
	}
}

# Homelab fallback (không có DNS API): mở file Caddyfile.homelab riêng,
# dùng on-demand + ask endpoint nội bộ. Không bật fallback này trên production.
