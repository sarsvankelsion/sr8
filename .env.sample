# sr8 production env — copy thành .env rồi đổi toàn bộ CHANGE-ME.
# Chế độ bảo vệ: "sealed" (mặc định HMAC/room/single-use) | "open" (tắt seal làm dịch vụ mở, vẫn giữ strip header/rate-limit)
SEAL_MODE=sealed
# Guard (dùng guard-go mặc định; guard Python giữ để dev/test)
SEAL_SECRET=CHANGE-ME-SEAL-SECRET-32-CHARS-MIN
GUARD_PORT=19090
FRPS_VHOST=127.0.0.1:8080
VHOST_HOST={name}.tunnel.example.com
SEAL_SINGLE_USE=1
SEAL_ROTATE_SECS=60
SEAL_ROOM_MAX_USES=50
SEAL_RATE_PER_MIN=120
SEAL_TRUSTED_PROXIES=127.0.0.1
SEAL_FORWARD_IP=0
SEAL_MAX_BODY_BYTES=10485760
SEAL_MAX_RESP_BYTES=52428800
# TCP sealed splice (chỉ guard-go): handshake "<name>:<exp>:<seal>\n" hoặc "<room>:<ticket>\n" trong 5s
TCP_SEAL_PORT=19091
TCP_BACKEND=127.0.0.1:18082
# Caddy wildcard DNS challenge (ví dụ Cloudflare + image caddy builder)
CF_API_TOKEN=CHANGE-ME
# frp token dùng chung cho frps/frpc (đổi 32+ ký tự)
FRP_TOKEN=CHANGE-ME-32-CHARS-MIN
# Auto-update policy: pinned | patch | latest
FRP_TRACK=patch
